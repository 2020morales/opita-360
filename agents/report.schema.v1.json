{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPITA 360 agent report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "agent", "status", "evidence", "findings", "limitations"],
  "properties": {
    "version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"enum": ["frontend", "backend", "calidad", "seguridad"]},
    "status": {"enum": ["inspected", "blocked"]},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
