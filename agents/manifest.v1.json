{
  "version": "1.0.0",
  "mode": "deterministic",
  "models": {
    "planner": {
      "provider": "ollama-local",
      "model": "qwen3.5:4b",
      "executed": false
    },
    "coder": {
      "provider": "ollama-local",
      "model": "qwen3.5:4b",
      "executed": false
    },
    "reviewer": {
      "provider": "ollama-local",
      "model": "qwen3.5:4b",
      "executed": false
    }
  },
  "agents": {
    "orquestador": {
      "model_profile": "planner",
      "role": "Validar especificación, delegar y reunir evidencias",
      "tools": [
        "delegate",
        "validate_report",
        "llm_chat"
      ],
      "read": []
    },
    "frontend": {
      "model_profile": "coder",
      "role": "Revisar React, accesibilidad y modo demostración",
      "tools": [
        "read_context",
        "llm_chat",
        "external_mcp"
      ],
      "read": [
        "README.md",
        "AGENTS.md",
        "frontend/AGENTS.md",
        ".github/skills/frontend-react/SKILL.md",
        "frontend/package.json",
        "frontend/src/main.jsx",
        "frontend/src/styles.css"
      ]
    },
    "backend": {
      "model_profile": "coder",
      "role": "Revisar FastAPI, validaciones y contratos",
      "tools": [
        "read_context",
        "llm_chat",
        "external_mcp"
      ],
      "read": [
        "README.md",
        "AGENTS.md",
        "backend/AGENTS.md",
        ".github/skills/backend-fastapi/SKILL.md",
        "backend/app/main.py",
        "backend/requirements.txt",
        "database/schema.sql"
      ]
    },
    "calidad": {
      "model_profile": "reviewer",
      "role": "Revisar cobertura y requerir pruebas reales",
      "tools": [
        "read_context",
        "llm_chat"
      ],
      "read": [
        "README.md",
        "frontend/package.json",
        "backend/requirements.txt",
        "agents/tests/test_runtime.py",
        "backend/tests/test_api.py"
      ]
    },
    "seguridad": {
      "model_profile": "reviewer",
      "role": "Revisar denegación por defecto y límites",
      "tools": [
        "read_context",
        "llm_chat"
      ],
      "read": [
        "AGENTS.md",
        "agents/manifest.v1.json",
        "agents/runtime.py",
        "agents/mcp_probe.py"
      ]
    }
  },
  "tools": {
    "read_context": {
      "version": "1.0.0",
      "write": false,
      "network": false,
      "max_bytes": 65536
    },
    "delegate": {
      "version": "1.0.0",
      "targets": [
        "frontend",
        "backend",
        "calidad",
        "seguridad"
      ]
    },
    "llm_chat": {
      "version": "1.0.0",
      "endpoint": "http://127.0.0.1:11434/api/chat",
      "network_scope": "loopback-only",
      "timeout_seconds": 180,
      "max_output_tokens": 768
    },
    "validate_report": {
      "version": "1.0.0",
      "contract": "report.schema.v1.json"
    },
    "external_mcp": {
      "version": "1.0.0",
      "transport": "stdio",
      "package": "@modelcontextprotocol/server-filesystem@2.3.0",
      "node_package": "node@24.13.0",
      "client_allowed_tools": [
        "read_text_file"
      ],
      "scope": "temporary context export",
      "server_read_only": false
    }
  },
  "limits": {
    "max_spec_chars": 4000,
    "max_delegations": 4,
    "max_correction_rounds": 2,
    "shell": false,
    "write": false,
    "network": false
  },
  "approvals": [
    "plan before execution",
    "dependencies and external tools",
    "changes to application",
    "publication or merge"
  ]
}
