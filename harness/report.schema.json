{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "task",
    "mode",
    "model",
    "evidence",
    "findings",
    "limitations",
    "status"
  ],
  "properties": {
    "role": {
      "enum": [
        "orquestador",
        "frontend",
        "backend",
        "calidad",
        "seguridad"
      ]
    },
    "task": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "inventory",
        "llm"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "const": "awaiting_human_review"
    }
  }
}
